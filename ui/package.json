{
  "name": "fugue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle": "tauri build",
    "bundle:mac": "tauri build --bundles app && codesign --force --deep --sign - src-tauri/target/release/bundle/macos/Fugue.app",
    "bundle:mac:dev": "tauri build --bundles app --features dev-lab --config src-tauri/tauri.dev.conf.json && codesign --force --deep --sign - \"src-tauri/target/release/bundle/macos/Fugue Dev.app\"",
    "dev:lab": "tauri dev --features dev-lab --config src-tauri/tauri.dev.conf.json",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "license": "MIT"
}
